# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=your_cron_secret

# Stripe — server-only (no NEXT_PUBLIC prefix)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe — browser-safe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe price IDs — $1/month first month, then full price
STRIPE_PRICE_STARTER_TRIAL=price_...   # $1/mo
STRIPE_PRICE_STARTER=price_...         # $99/mo
STRIPE_PRICE_PRO_TRIAL=price_...       # $1/mo
STRIPE_PRICE_PRO=price_...             # $249/mo
STRIPE_PRICE_BUSINESS_TRIAL=price_...  # $1/mo
STRIPE_PRICE_BUSINESS=price_...        # $599/mo

# Email
RESEND_API_KEY=re_...

# AI
ANTHROPIC_API_KEY=sk-ant-...
